# ==========================================
# Rust & Cargo
# ==========================================
# Папка со скомпилированными бинарниками и артефактами
/target/

# Резервные копии файлов, создаваемые cargo/rustc
**/*.rs.bk
*.rmeta
*.bk

# Примечание по Cargo.lock:
# Для библиотек (crates) Cargo.lock обычно НЕ добавляют в git,
# чтобы гарантировать сборку с новейшими совместимыми зависимостями.
# Раскомментируйте строчку ниже, если хотите игнорировать его:
# Cargo.lock


# ==========================================
# IDE & Редакторы кода
# ==========================================
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (RustRover, CLion, IntelliJ IDEA)
.idea/
*.iml

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
.\#*


# ==========================================
# Переменные окружения и секреты
# ==========================================
.env
.env.*
!.env.example


# ==========================================
# Операционные системы
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
AppleVolumes.NSDB

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/


# ==========================================
# Логи и временные файлы
# ==========================================
*.log